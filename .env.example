PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pos_db

# JWT Configuration
JWT_SECRET=pos_jwt_access_secret_key_123
# Access token expiration: 900s = 15 minutes (short-lived for POS terminal security)
JWT_EXPIRATION=900s
JWT_REFRESH_SECRET=pos_jwt_refresh_secret_key_123
# Refresh token expiration: 28800s = 8 hours (standard retail shift window)
JWT_REFRESH_EXPIRATION=28800s

# Redis Configuration (Optional in local dev, fallback to in-memory)
REDIS_HOST=localhost
REDIS_PORT=6379
