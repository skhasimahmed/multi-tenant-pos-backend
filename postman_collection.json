          "name": "Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sale completed successfully', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('id');",
                  "    pm.expect(res.status).to.equal('COMPLETED');",
                  "    if (res.id) {",
                  "        pm.collectionVariables.set('saleId', res.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
