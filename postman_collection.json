          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales", "{{saleId}}"]
            }
          }
        }
      ]
    }
  ]
}