{
  "info": {
    "name": "POS Backend API",
    "description": "Postman collection for POS Sales & Inventory Backend.\n\nQuick flow:\n1. Auth > Login (Cashier) -> saves token & storeId\n2. Products > List Products -> saves productId\n3. Sales > Checkout -> processes sale with row locking & server pricing\n4. Sales > Checkout (Idempotency Replay) -> tests cached response replay\n5. Sales > Get Sale by ID -> fetches receipt by saleId\n\nDefault seeded password: Password123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "saleId",
      "value": "",
      "type": "string"
    }
  ],
